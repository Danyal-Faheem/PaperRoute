# Hosted live runs only; never commit the real value. A compatible endpoint can be used instead.
OPENAI_API_KEY=replace-me
# Optional local OpenAI-compatible server (takes precedence over hosted Responses).
# PAPERROUTE_OPENAI_BASE_URL=http://10.127.78.117:8000/v1
# PAPERROUTE_API_KEY=local
# Models are configurable for cost/reproducibility.
PAPERROUTE_SOLVER_MODEL=gpt-5.6-terra
PAPERROUTE_JUDGE_MODEL=gpt-5.6
PAPERROUTE_DATABASE=data/runtime/paperroute.sqlite3
PAPERROUTE_CACHE_DIR=./data/papers
PAPERROUTE_DEMO_MODE=false
PAPERROUTE_EVALUATION_PATH=data/runtime/latest-evaluation.json
PAPERROUTE_TIMEOUT=300
PAPERROUTE_PDF_TEXT_LIMIT=60000
PAPERROUTE_LOG_LEVEL=INFO
